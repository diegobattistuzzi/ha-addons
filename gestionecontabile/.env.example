# Backend
PORT=8099
DATA_DIR=./data

# AI (scegli uno). Se assente, si prova ai_task.generate_data di Home Assistant
# come fallback, ma in sviluppo locale (fuori da HA) quel fallback non e'
# disponibile: serve una di queste chiavi per testare categorizzazione/PDF.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Open Banking (GoCardless/Nordigen)
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=
NORDIGEN_BASE_URL=https://bankaccountdata.gocardless.com/api/v2

# Sync
SYNC_INTERVAL_MINUTES=30

# Home Assistant
HA_TOKEN=
HA_BASE_URL=http://homeassistant:8123
